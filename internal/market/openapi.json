{
  "openapi": "3.0.3",
  "info": {
    "title": "Campus Market V1 Accounts",
    "version": "1.0.0",
    "description": "Seed accounts only. Access tokens expire after 3600 seconds. No registration, refresh or revocation. Requests are limited to 4096 bytes; unknown properties, empty patches and trailing JSON are rejected. Profile writes affect only the authenticated account; credit score stays preset."
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Log in using a seeded account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "Maximum 64 UTF-8 bytes."
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 1,
                    "maxLength": 72,
                    "description": "Maximum 72 UTF-8 bytes."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "accessToken",
                    "tokenType",
                    "expiresIn",
                    "expiresAt"
                  ],
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    },
                    "tokenType": {
                      "type": "string",
                      "enum": [
                        "Bearer"
                      ]
                    },
                    "expiresIn": {
                      "type": "integer",
                      "enum": [
                        3600
                      ]
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error envelope: invalid_input (400), invalid_credentials or unauthorized (401), unavailable (503).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error envelope: invalid_input (400), invalid_credentials or unauthorized (401), unavailable (503).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error envelope: invalid_input (400), invalid_credentials or unauthorized (401), unavailable (503).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "summary": "Read current authenticated profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "Error envelope: invalid_input (400), invalid_credentials or unauthorized (401), unavailable (503).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error envelope: invalid_input (400), invalid_credentials or unauthorized (401), unavailable (503).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update own nickname and/or avatar",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "nickname": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "description": "1–40 Unicode characters, not whitespace-only."
                  },
                  "avatar": {
                    "type": "string",
                    "maxLength": 2048,
                    "format": "uri",
                    "pattern": "^https?://",
                    "description": "HTTP/HTTPS URL with hostname and no credentials; maximum 2048 UTF-8 bytes. Stored as an address; reachability is not checked."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "400": {
            "description": "Error envelope: invalid_input (400), invalid_credentials or unauthorized (401), unavailable (503).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error envelope: invalid_input (400), invalid_credentials or unauthorized (401), unavailable (503).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error envelope: invalid_input (400), invalid_credentials or unauthorized (401), unavailable (503).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "MongoDB readiness",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Error envelope: invalid_input (400), invalid_credentials or unauthorized (401), unavailable (503).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Paste accessToken from POST /auth/login into Authorize. Valid for one hour."
      }
    },
    "schemas": {
      "Profile": {
        "type": "object",
        "required": [
          "id",
          "username",
          "nickname",
          "avatar",
          "creditScore",
          "completedSales"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "creditScore": {
            "type": "integer"
          },
          "completedSales": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_input",
                  "invalid_credentials",
                  "unauthorized",
                  "unavailable"
                ]
              }
            }
          }
        }
      }
    }
  }
}
